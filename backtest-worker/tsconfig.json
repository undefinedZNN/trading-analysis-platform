{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["node", "jest"],
    "paths": {
      "@trading-platform/backtesting-contracts": ["../libs/backtesting-contracts/src"],
      "class-validator": ["node_modules/class-validator"],
      "class-transformer": ["node_modules/class-transformer"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/backtesting/**/__tests__/**",
    "src/backtesting/data/providers/examples/**",
    "src/backtesting/data/timeframe/test-runner.ts"
  ]
}

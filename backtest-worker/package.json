{
  "name": "backtest-worker",
  "version": "0.1.0",
  "description": "Isolated backtest worker service",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "postbuild": "node scripts/ensure-dist-entry.js",
    "prepare-entry": "node scripts/ensure-dist-entry.js",
    "start": "npm run prepare-entry && node dist/src/main.js",
    "start:dev": "npm run prepare-entry && nest start --watch",
    "start:debug": "npm run prepare-entry && nest start --debug --watch",
    "scripts:dry-run": "DRY_RUN=true ./scripts/start-workers.sh && DRY_RUN=true ./scripts/stop-workers.sh",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/axios": "^3.1.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "axios": "^1.7.7",
    "big.js": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.1.0",
    "duckdb": "^0.10.0",
    "nanoid": "^3.3.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.5",
    "@nestjs/testing": "^10.4.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/src/backtesting/"
    ],
    "moduleNameMapper": {
      "^@trading-platform/backtesting-contracts$": "<rootDir>/../libs/backtesting-contracts/src"
    }
  }
}
